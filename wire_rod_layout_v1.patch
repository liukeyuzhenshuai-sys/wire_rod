diff --git a/tests/check_repository_governance.py b/tests/check_repository_governance.py
new file mode 100644
--- /dev/null
+++ b/tests/check_repository_governance.py
@@ -0,0 +1,71 @@
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+DOC = ROOT / 'doc'
+DATASET = ROOT / 'dataset'
+
+
+def main():
+    errors = []
+
+    for legacy in ('docs', 'design', 'labels'):
+        if (ROOT / legacy).exists():
+            errors.append(f'legacy repository path must not exist: {legacy}/')
+
+    root_ply = sorted(ROOT.glob('*.ply'))
+    if root_ply:
+        errors.append(f'PLY files must live in dataset/: found {len(root_ply)} in repository root')
+
+    required = [
+        ROOT / 'AGENTS.md',
+        DOC / 'GOVERNANCE.md',
+        DOC / 'requirements',
+        DOC / 'design',
+        DOC / 'decisions',
+        DOC / 'status',
+        DATASET,
+        DATASET / 'labels',
+    ]
+    for path in required:
+        if not path.exists():
+            errors.append(f'missing canonical path: {path.relative_to(ROOT)}')
+
+    for ply in ROOT.rglob('*.ply'):
+        try:
+            ply.relative_to(DATASET)
+        except ValueError:
+            errors.append(f'PLY outside dataset/: {ply.relative_to(ROOT)}')
+
+    protected_name_patterns = (
+        '*REQUIREMENT*.md',
+        '*REQUIREMENTS*.md',
+        '*DESIGN*.md',
+        '*DECISION*.md',
+        '*DECISIONS*.md',
+    )
+    allowed_doc_roots = {
+        DOC / 'requirements',
+        DOC / 'design',
+        DOC / 'decisions',
+    }
+    for pattern in protected_name_patterns:
+        for path in ROOT.rglob(pattern):
+            if any(base == path.parent or base in path.parents for base in allowed_doc_roots):
+                continue
+            errors.append(f'protected-looking document outside canonical protected directories: {path.relative_to(ROOT)}')
+
+    if errors:
+        print('REPOSITORY GOVERNANCE: FAIL')
+        for err in errors:
+            print(f'- {err}')
+        raise SystemExit(1)
+
+    print('REPOSITORY GOVERNANCE: PASS')
+    print(f'- doc root: {DOC.relative_to(ROOT)}')
+    print(f'- dataset root: {DATASET.relative_to(ROOT)}')
+    print(f'- dataset PLY count: {len(list(DATASET.glob("*.ply")))}')
+    print('- protected specification directories are canonical')
+
+
+if __name__ == '__main__':
+    main()
